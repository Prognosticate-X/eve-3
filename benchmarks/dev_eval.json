{
  "split": "dev_eval",
  "description": "Validation tasks used for library learning and prober tuning",
  "tasks": [
    {
      "task_id": "list_double_all",
      "task_family": "list_mapping",
      "description": "Multiply each element in list by 2",
      "visible_examples": [
        {"input": [1, 2, 3], "output": [2, 4, 6]},
        {"input": [4, 0], "output": [8, 0]}
      ],
      "hidden_tests": [
        {"input": [], "output": []},
        {"input": [-3, 5], "output": [-6, 10]}
      ],
      "reference_program": "(map (lambda (a) (* a 2)) x)"
    },
    {
      "task_id": "list_sum",
      "task_family": "list_reduction",
      "description": "Compute sum of all elements in list",
      "visible_examples": [
        {"input": [1, 2, 3], "output": 6},
        {"input": [10, -5], "output": 5}
      ],
      "hidden_tests": [
        {"input": [], "output": 0},
        {"input": [100, 200, 300], "output": 600}
      ],
      "reference_program": "(sum x)"
    }
  ]
}
