{
  "split": "held_out_test",
  "description": "Strictly held-out tasks used only for final generalization evaluation",
  "tasks": [
    {
      "task_id": "filter_greater_than_two",
      "task_family": "list_filtering",
      "description": "Filter elements strictly greater than 2",
      "visible_examples": [
        {"input": [1, 2, 3, 4], "output": [3, 4]},
        {"input": [0, 5, -2], "output": [5]}
      ],
      "hidden_tests": [
        {"input": [2, 2, 2], "output": []},
        {"input": [10, 20], "output": [10, 20]}
      ],
      "reference_program": "(filter (lambda (a) (gt a 2)) x)"
    },
    {
      "task_id": "list_reverse",
      "task_family": "list_structural",
      "description": "Reverse list order",
      "visible_examples": [
        {"input": [1, 2, 3], "output": [3, 2, 1]},
        {"input": [4, 5], "output": [5, 4]}
      ],
      "hidden_tests": [
        {"input": [], "output": []},
        {"input": [1], "output": [1]},
        {"input": [1, 2, 1], "output": [1, 2, 1]}
      ],
      "reference_program": "(reverse x)"
    },
    {
      "task_id": "filter_positive",
      "task_family": "list_filtering",
      "description": "Filter positive numbers strictly greater than 0",
      "visible_examples": [
        {"input": [-1, 0, 1, 2], "output": [1, 2]},
        {"input": [-5, -10], "output": []}
      ],
      "hidden_tests": [
        {"input": [], "output": []},
        {"input": [100, -50, 25], "output": [100, 25]}
      ],
      "reference_program": "(filter (lambda (a) (gt a 0)) x)"
    }
  ]
}
