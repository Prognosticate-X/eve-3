{
  "family_id": "list_structural",
  "name": "List Structural Operations",
  "description": "Structural manipulation, reordering, and slicing of integer lists",
  "is_held_out": false,
  "tasks": [
    {
      "task_id": "list_reverse",
      "task_family": "list_structural",
      "description": "Reverse list order",
      "visible_examples": [
        {"input": [1, 2, 3], "output": [3, 2, 1]},
        {"input": [4, 5], "output": [5, 4]}
      ],
      "hidden_tests": [
        {"input": [], "output": []},
        {"input": [1], "output": [1]},
        {"input": [1, 2, 1], "output": [1, 2, 1]}
      ],
      "reference_program": "(reverse x)"
    },
    {
      "task_id": "list_tail_elements",
      "task_family": "list_structural",
      "description": "Return all elements except the first",
      "visible_examples": [
        {"input": [1, 2, 3], "output": [2, 3]},
        {"input": [5], "output": []}
      ],
      "hidden_tests": [
        {"input": [], "output": []},
        {"input": [10, 20, 30, 40], "output": [20, 30, 40]}
      ],
      "reference_program": "(tail x)"
    }
  ]
}
