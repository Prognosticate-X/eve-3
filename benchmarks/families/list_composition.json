{
  "family_id": "list_composition",
  "name": "List Composition Operations (Held-Out Suite)",
  "description": "Composite multi-stage higher-order operations strictly held out to evaluate forward transfer (FWT)",
  "is_held_out": true,
  "tasks": [
    {
      "task_id": "filter_evens_and_sum",
      "task_family": "list_composition",
      "description": "Filter even numbers from list and compute their sum",
      "visible_examples": [
        {"input": [1, 2, 3, 4], "output": 6},
        {"input": [1, 3, 5], "output": 0}
      ],
      "hidden_tests": [
        {"input": [], "output": 0},
        {"input": [10, 15, 20], "output": 30},
        {"input": [2, 4, 6], "output": 12}
      ],
      "reference_program": "(sum (filter (lambda (a) (is_even a)) x))"
    },
    {
      "task_id": "filter_positive_and_sum",
      "task_family": "list_composition",
      "description": "Filter positive numbers from list and compute their sum",
      "visible_examples": [
        {"input": [-1, 2, -3, 4], "output": 6},
        {"input": [-5, -10], "output": 0}
      ],
      "hidden_tests": [
        {"input": [], "output": 0},
        {"input": [10, -5, 20], "output": 30},
        {"input": [1, 2, 3], "output": 6}
      ],
      "reference_program": "(sum (filter (lambda (a) (gt a 0)) x))"
    },
    {
      "task_id": "reverse_and_tail",
      "task_family": "list_composition",
      "description": "Reverse list and drop the first element of reversed result",
      "visible_examples": [
        {"input": [1, 2, 3], "output": [2, 1]},
        {"input": [5], "output": []}
      ],
      "hidden_tests": [
        {"input": [], "output": []},
        {"input": [10, 20, 30, 40], "output": [30, 20, 10]}
      ],
      "reference_program": "(tail (reverse x))"
    }
  ]
}
