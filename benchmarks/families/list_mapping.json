{
  "family_id": "list_mapping",
  "name": "List Mapping Operations",
  "description": "Element-wise transformation and mapping functions over integer lists",
  "is_held_out": false,
  "tasks": [
    {
      "task_id": "list_increment_all",
      "task_family": "list_mapping",
      "description": "Increment each element in list by 1",
      "visible_examples": [
        {"input": [1, 2, 3], "output": [2, 3, 4]},
        {"input": [0, -1, 5], "output": [1, 0, 6]}
      ],
      "hidden_tests": [
        {"input": [], "output": []},
        {"input": [10, 20, 30], "output": [11, 21, 31]},
        {"input": [-5, -10], "output": [-4, -9]}
      ],
      "reference_program": "(map (lambda (a) (+ a 1)) x)"
    },
    {
      "task_id": "list_double_all",
      "task_family": "list_mapping",
      "description": "Multiply each element in list by 2",
      "visible_examples": [
        {"input": [1, 2, 3], "output": [2, 4, 6]},
        {"input": [4, 0], "output": [8, 0]}
      ],
      "hidden_tests": [
        {"input": [], "output": []},
        {"input": [-3, 5], "output": [-6, 10]}
      ],
      "reference_program": "(map (lambda (a) (* a 2)) x)"
    },
    {
      "task_id": "list_decrement_all",
      "task_family": "list_mapping",
      "description": "Subtract 1 from each element in list",
      "visible_examples": [
        {"input": [1, 2, 3], "output": [0, 1, 2]},
        {"input": [0, -4], "output": [-1, -5]}
      ],
      "hidden_tests": [
        {"input": [], "output": []},
        {"input": [10, 100], "output": [9, 99]}
      ],
      "reference_program": "(map (lambda (a) (- a 1)) x)"
    }
  ]
}
