{
  "benchmark_name": "ood_constants",
  "description": "Out-of-distribution constant generalization suite (S1.1 Section C.4). Tests whether synthesizers generalize to unseen constants (4, 6, 7, 3) not present in hardcoded templates.",
  "tasks": [
    {
      "task_name": "map_add_four",
      "family": "list_mapping",
      "description": "Add 4 to each element in integer list",
      "visible_examples": [
        {"input": [0, 1, 2], "output": [4, 5, 6]},
        {"input": [4, 10], "output": [8, 14]}
      ],
      "hidden_tests": [
        {"input": [], "output": []},
        {"input": [-4, -1], "output": [0, 3]},
        {"input": [100, -20], "output": [104, -16]}
      ],
      "reference_program": "(map (lambda (a) (+ a 4)) x)"
    },
    {
      "task_name": "filter_greater_than_seven",
      "family": "list_filtering",
      "description": "Filter elements strictly greater than 7",
      "visible_examples": [
        {"input": [5, 7, 8, 10], "output": [8, 10]},
        {"input": [1, 3, 7], "output": []}
      ],
      "hidden_tests": [
        {"input": [6, 7, 8], "output": [8]},
        {"input": [10, 20, 5], "output": [10, 20]},
        {"input": [], "output": []}
      ],
      "reference_program": "(filter (lambda (a) (gt a 7)) x)"
    },
    {
      "task_name": "map_multiply_three",
      "family": "list_mapping",
      "description": "Multiply each element in integer list by 3",
      "visible_examples": [
        {"input": [1, 2, 3], "output": [3, 6, 9]},
        {"input": [0, -2], "output": [0, -6]}
      ],
      "hidden_tests": [
        {"input": [], "output": []},
        {"input": [10, -5], "output": [30, -15]},
        {"input": [4, 7], "output": [12, 21]}
      ],
      "reference_program": "(map (lambda (a) (* a 3)) x)"
    },
    {
      "task_name": "filter_greater_than_six",
      "family": "list_filtering",
      "description": "Filter elements strictly greater than 6",
      "visible_examples": [
        {"input": [4, 6, 8, 9], "output": [8, 9]},
        {"input": [0, 2, 6], "output": []}
      ],
      "hidden_tests": [
        {"input": [5, 6, 7], "output": [7]},
        {"input": [12, -1, 6], "output": [12]},
        {"input": [], "output": []}
      ],
      "reference_program": "(filter (lambda (a) (gt a 6)) x)"
    }
  ]
}
